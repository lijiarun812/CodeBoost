      "final_code": "class Solution:\n    def maxProfit(self, prices):\n        if not prices:\n            return 0\n        \n        n = len(prices)\n        hold = -prices[0]  # Max profit if we hold a stock\n        sold = 0           # Max profit if we just sold today\n        rest = 0           # Max profit if we are in cooldown or not holding\n        \n        for i in range(1, n):\n            prev_sold = sold\n            sold = hold + prices[i]\n            hold = max(hold, rest - prices[i])\n            rest = max(rest, prev_sold)\n        \n        return max(sold, rest)\n",
