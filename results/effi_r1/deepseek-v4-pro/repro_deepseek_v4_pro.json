      "final_code": "class Solution:\n    def countSmaller(self, nums):\n        # Coordinate compression\n        sorted_unique = sorted(set(nums))\n        rank = {val: i + 1 for i, val in enumerate(sorted_unique)}\n        \n        def update(index, value, bit, size):\n            while index <= size:\n                bit[index] += value\n                index += index & -index\n        \n        def query(index, bit):\n            total = 0\n            while index > 0:\n                total += bit[index]\n                index -= index & -index\n            return total\n        \n        size = len(sorted_unique)\n        bit = [0] * (size + 1)\n        res = [0] * len(nums)\n        \n        # Traverse from right to left\n        for i in range(len(nums) - 1, -1, -1):\n            r = rank[nums[i]]\n            res[i] = query(r - 1, bit)\n            update(r, 1, bit, size)\n        \n        return res\n",
