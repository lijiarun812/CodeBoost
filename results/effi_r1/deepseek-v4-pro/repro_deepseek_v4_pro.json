      "final_code": "class Solution:\n    def minCostII(self, costs):\n        if not costs:\n            return 0\n        \n        n = len(costs)\n        k = len(costs[0])\n        \n        # Initialize dp with the first row\n        prev_dp = costs[0][:]\n        \n        for i in range(1, n):\n            curr_dp = [0] * k\n            \n            # Find the minimum and second minimum costs from previous row\n            min1 = float('inf')\n            min2 = float('inf')\n            min1_idx = -1\n            \n            for j in range(k):\n                if prev_dp[j] < min1:\n                    min2 = min1\n                    min1 = prev_dp[j]\n                    min1_idx = j\n                elif prev_dp[j] < min2:\n                    min2 = prev_dp[j]\n            \n            # Compute current row costs\n            for j in range(k):\n                if j != min1_idx:\n                    curr_dp[j] = costs[i][j] + min1\n                else:\n                    curr_dp[j] = costs[i][j] + min2\n            \n            prev_dp = curr_dp\n        \n        return min(prev_dp)\n",
