      "final_code": "class Solution:\n    def maxProfit(self, prices):\n        if not prices:\n            return 0\n        \n        n = len(prices)\n        hold = -prices[0]  # Max profit if we buy/hold a stock\n        sold = 0           # Max profit if we just sold a stock\n        rest = 0           # Max profit if we are in cooldown/rest\n        \n        for i in range(1, n):\n            prev_sold = sold\n            sold = hold + prices[i]      # Sell stock\n            hold = max(hold, rest - prices[i])  # Buy stock after cooldown\n            rest = max(rest, prev_sold)  # Cooldown after selling\n        \n        return max(sold, rest)\n",
