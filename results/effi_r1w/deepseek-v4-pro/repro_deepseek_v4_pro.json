      "final_code": "class Solution:\n    def countSmaller(self, nums):\n        # Coordinate compression\n        sorted_unique = sorted(set(nums))\n        rank = {val: idx + 1 for idx, val in enumerate(sorted_unique)}\n        \n        def update(index, value, bit, size):\n            while index <= size:\n                bit[index] += value\n                index += index & -index\n        \n        def query(index, bit):\n            total = 0\n            while index > 0:\n                total += bit[index]\n                index -= index & -index\n            return total\n        \n        n = len(nums)\n        bit = [0] * (len(sorted_unique) + 1)\n        counts = [0] * n\n        \n        # Traverse from right to left\n        for i in range(n - 1, -1, -1):\n            r = rank[nums[i]]\n            counts[i] = query(r - 1, bit)\n            update(r, 1, bit, len(sorted_unique))\n        \n        return counts\n",
