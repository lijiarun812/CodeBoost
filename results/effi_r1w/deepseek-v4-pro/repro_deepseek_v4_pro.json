      "final_code": "class Solution:\n    def closestValue(self, root, target):\n        closest = root.val\n        while root:\n            if abs(root.val - target) < abs(closest - target) or (\n                abs(root.val - target) == abs(closest - target) and root.val < closest\n            ):\n                closest = root.val\n            if target < root.val:\n                root = root.left\n            else:\n                root = root.right\n        return closest\n",
