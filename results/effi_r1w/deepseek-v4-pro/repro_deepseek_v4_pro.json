      "final_code": "from typing import List\n\nclass Solution:\n    def removeInvalidParentheses(self, s: str) -> List[str]:\n        # First, find out how many misplaced parentheses we have\n        left_remove, right_remove = 0, 0\n        for char in s:\n            if char == '(':\n                left_remove += 1\n            elif char == ')':\n                if left_remove > 0:\n                    left_remove -= 1\n                else:\n                    right_remove += 1\n\n        result = set()\n\n        def dfs(index, left_count, right_count, left_remove, right_remove, path):\n            if index == len(s):\n                if left_remove == 0 and right_remove == 0:\n                    result.add(path)\n                return\n\n            char = s[index]\n\n            if char == '(' and left_remove > 0:\n                # Option to remove this '('\n                dfs(index + 1, left_count, right_count, left_remove - 1, right_remove, path)\n            elif char == ')' and right_remove > 0:\n                # Option to remove this ')'\n                dfs(index + 1, left_count, right_count, left_remove, right_remove - 1, path)\n\n            # Option to keep the current char\n            if char == '(':\n                dfs(index + 1, left_count + 1, right_count, left_remove, right_remove, path + char)\n            elif char == ')':\n                if left_count > right_count:\n                    dfs(index + 1, left_count, right_count + 1, left_remove, right_remove, path + char)\n            else:\n                dfs(index + 1, left_count, right_count, left_remove, right_remove, path + char)\n\n        dfs(0, 0, 0, left_remove, right_remove, \"\")\n        return list(result)\n",
