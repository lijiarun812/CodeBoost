      "final_code": "class Solution:\n    def minCostII(self, costs):\n        if not costs or not costs[0]:\n            return 0\n        \n        n, k = len(costs), len(costs[0])\n        \n        # Initialize dp with the first row\n        prev_dp = costs[0][:]\n        prev_min = min(prev_dp)\n        prev_min_index = prev_dp.index(prev_min)\n        prev_second_min = min(v for i, v in enumerate(prev_dp) if i != prev_min_index)\n        \n        for i in range(1, n):\n            curr_dp = [0] * k\n            curr_min = float('inf')\n            curr_min_index = -1\n            curr_second_min = float('inf')\n            \n            for j in range(k):\n                if j != prev_min_index:\n                    curr_dp[j] = costs[i][j] + prev_min\n                else:\n                    curr_dp[j] = costs[i][j] + prev_second_min\n                \n                if curr_dp[j] < curr_min:\n                    curr_second_min = curr_min\n                    curr_min = curr_dp[j]\n                    curr_min_index = j\n                elif curr_dp[j] < curr_second_min:\n                    curr_second_min = curr_dp[j]\n            \n            prev_dp, prev_min, prev_min_index, prev_second_min = curr_dp, curr_min, curr_min_index, curr_second_min\n        \n        return prev_min\n",
