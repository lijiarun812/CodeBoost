      "final_code": "class Solution:\n    def removeInvalidParentheses(self, s: str):\n        def is_valid(string):\n            count = 0\n            for char in string:\n                if char == '(':\n                    count += 1\n                elif char == ')':\n                    count -= 1\n                    if count < 0:\n                        return False\n            return count == 0\n\n        # Count how many '(' and ')' need to be removed\n        left_remove = 0\n        right_remove = 0\n        for char in s:\n            if char == '(':\n                left_remove += 1\n            elif char == ')':\n                if left_remove > 0:\n                    left_remove -= 1\n                else:\n                    right_remove += 1\n\n        result = set()\n\n        def dfs(index, left_count, right_count, left_rem, right_rem, current):\n            if index == len(s):\n                if left_rem == 0 and right_rem == 0 and left_count == right_count:\n                    result.add(current)\n                return\n\n            char = s[index]\n\n            if char == '(':\n                # Option 1: keep this '('\n                dfs(index + 1, left_count + 1, right_count, left_rem, right_rem, current + '(')\n                # Option 2: remove this '('\n                if left_rem > 0:\n                    dfs(index + 1, left_count, right_count, left_rem - 1, right_rem, current)\n            elif char == ')':\n                # Option 1: keep this ')'\n                if left_count > right_count:\n                    dfs(index + 1, left_count, right_count + 1, left_rem, right_rem, current + ')')\n                # Option 2: remove this ')'\n                if right_rem > 0:\n                    dfs(index + 1, left_count, right_count, left_rem, right_rem - 1, current)\n            else:\n                # Letters are always kept\n                dfs(index + 1, left_count, right_count, left_rem, right_rem, current + char)\n\n        dfs(0, 0, 0, left_remove, right_remove, \"\")\n        return list(result)\n",
