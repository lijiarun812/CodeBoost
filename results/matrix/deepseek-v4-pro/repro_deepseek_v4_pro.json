      "final_code": "from collections import deque\n\nclass Solution:\n    def alienOrder(self, words):\n        # Build graph using dict of sets and indegree dict\n        graph = {}\n        indegree = {}\n        \n        # Initialize all unique characters\n        for word in words:\n            for ch in word:\n                if ch not in indegree:\n                    indegree[ch] = 0\n                    graph[ch] = set()\n        \n        # Find edges\n        for i in range(len(words) - 1):\n            w1, w2 = words[i], words[i + 1]\n            min_len = min(len(w1), len(w2))\n            \n            # Check invalid prefix case\n            if len(w1) > len(w2) and w1[:min_len] == w2[:min_len]:\n                return \"\"\n            \n            for j in range(min_len):\n                c1, c2 = w1[j], w2[j]\n                if c1 != c2:\n                    if c2 not in graph[c1]:\n                        graph[c1].add(c2)\n                        indegree[c2] += 1\n                    break\n        \n        # Topological sort (Kahn's algorithm)\n        queue = deque([ch for ch in indegree if indegree[ch] == 0])\n        order = []\n        \n        while queue:\n            ch = queue.popleft()\n            order.append(ch)\n            for neighbor in graph[ch]:\n                indegree[neighbor] -= 1\n                if indegree[neighbor] == 0:\n                    queue.append(neighbor)\n        \n        if len(order) == len(indegree):\n            return \"\".join(order)\n        return \"\"\n",
