      "final_code": "class Solution:\n    def nthUglyNumber(self, n: int) -> int:\n        ugly = [1] * n\n        i2 = i3 = i5 = 0\n        next2, next3, next5 = 2, 3, 5\n        for idx in range(1, n):\n            next_ugly = next2 if next2 < next3 else next3\n            if next5 < next_ugly:\n                next_ugly = next5\n            ugly[idx] = next_ugly\n            if next_ugly == next2:\n                i2 += 1\n                next2 = ugly[i2] * 2\n            if next_ugly == next3:\n                i3 += 1\n                next3 = ugly[i3] * 3\n            if next_ugly == next5:\n                i5 += 1\n                next5 = ugly[i5] * 5\n        return ugly[-1]\n",
