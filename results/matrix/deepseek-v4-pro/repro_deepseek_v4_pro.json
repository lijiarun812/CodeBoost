      "final_code": "class Solution:\n    def minCostII(self, costs):\n        if not costs or not costs[0]:\n            return 0\n        \n        n = len(costs)\n        k = len(costs[0])\n        \n        prev_dp = costs[0]\n        \n        for i in range(1, n):\n            min1 = min2 = float('inf')\n            idx1 = -1\n            \n            for j, val in enumerate(prev_dp):\n                if val < min1:\n                    min2 = min1\n                    min1 = val\n                    idx1 = j\n                elif val < min2:\n                    min2 = val\n            \n            curr_costs = costs[i]\n            curr_dp = [0] * k\n            \n            for j in range(k):\n                curr_dp[j] = curr_costs[j] + (min1 if j != idx1 else min2)\n            \n            prev_dp = curr_dp\n        \n        return min(prev_dp)\n",
